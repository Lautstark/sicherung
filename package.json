{
  "name": "@lautstark/sicherung",
  "version": "1.7.0",
  "type": "module",
  "description": "Keeps a browser-held backup written to a folder the user picked, so a cleared cache is not the end of the work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lautstark/sicherung.git"
  },
  "keywords": [
    "aac",
    "backup",
    "file-system-access",
    "indexeddb"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./ablage": {
      "types": "./dist/ablage.d.ts",
      "default": "./dist/ablage.js"
    },
    "./ablage-ui": {
      "types": "./dist/ablage-ui.d.ts",
      "default": "./dist/ablage-ui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build",
    "preversion": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
